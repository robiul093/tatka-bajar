# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Tatka Bajar"
APP_URL=http://localhost:3000

# Database
DATABASE_URL=db url
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SendGrid/SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=email@example.com
EMAIL_PASSWORD=password
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="Tatka Bajar"

# Cloudinary Configuration (File Storage)
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret

# Admin Settings
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=SuperSecurePassword123!

# Seeder Credentials for All Roles (ADMIN, USER, RIDER)
SEED_ADMIN_NAME="Admin User"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_PHONE=+8801700000001

SEED_USER_NAME="Default User"
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@123456
SEED_USER_PHONE=+8801700000002

SEED_RIDER_NAME="Default Rider"
SEED_RIDER_EMAIL=rider@example.com
SEED_RIDER_PASSWORD=Rider@123456
SEED_RIDER_PHONE=+8801700000003

