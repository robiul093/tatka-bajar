              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"OTP verified successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"message\": \"OTP verified successfully\",\n    \"valid\": true\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
