              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Password reset successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"message\": \"Password reset successfully\"\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.tokens) {",
                  "  const token = res.data.tokens.accessToken;",
                  "  const role  = res.data.user && res.data.user.role;",
                  "",
                  "  // Always store the generic accessToken",
                  "  pm.collectionVariables.set('accessToken', token);",
                  "",
                  "  // Store role-specific token",
                  "  if (role === 'USER') {",
                  "    pm.collectionVariables.set('userToken', token);",
                  "    console.log('userToken set for role:', role);",
                  "  } else if (role === 'ADMIN') {",
                  "    pm.collectionVariables.set('adminToken', token);",
                  "    console.log('adminToken set for role:', role);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Login successful\",\n  \"meta\": null,\n  \"data\": {\n    \"tokens\": {\n      \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n      \"refreshToken\": \"eyJhbGciOiJIUzI1NiJ9...\"\n    },\n    \"user\": {\n      \"userId\": \"uuid\",\n      \"name\": \"John Doe\",\n      \"email\": \"john@example.com\",\n      \"phone\": \"01700000000\",\n      \"role\": \"USER\",\n      \"status\": \"ACTIVE\",\n      \"isVerified\": true\n    }\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.tokens) {",
                  "  const token = res.data.tokens.accessToken;",
                  "  const role  = res.data.user && res.data.user.role;",
                  "",
                  "  pm.collectionVariables.set('accessToken', token);",
                  "",
                  "  if (role === 'USER') {",
                  "    pm.collectionVariables.set('userToken', token);",
                  "    console.log('userToken set for role:', role);",
                  "  } else if (role === 'ADMIN') {",
                  "    pm.collectionVariables.set('adminToken', token);",
                  "    console.log('adminToken set for role:', role);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"SuperSecurePassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"<userId>\",\n  \"refreshToken\": \"<refreshToken>\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Token refreshed successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n    \"refreshToken\": \"eyJhbGciOiJIUzI1NiJ9...\"\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Get Me (Current User)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"User profile fetched successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"userId\": \"uuid\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"01700000000\",\n    \"role\": \"USER\",\n    \"status\": \"ACTIVE\",\n    \"isVerified\": true,\n    \"profile\": null,\n    \"isNotification\": true,\n    \"isAgree\": false,\n    \"createdAt\": \"2026-09-04T12:00:00.000Z\",\n    \"updatedAt\": \"2026-09-04T12:00:00.000Z\"\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
