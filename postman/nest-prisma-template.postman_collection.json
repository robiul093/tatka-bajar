{
  "info": {
    "_postman_id": "tatka-bajar-collection",
    "name": "Tatka Bajar API",
    "description": "Complete Tatka Bajar API collection.\n\n**Base URL:** `{{baseUrl}}/api/v1`\n\n**How to use:**\n1. Import this collection.\n2. Set `baseUrl` in the environment (default: `http://localhost:3000`).\n3. Hit **Login** — `accessToken`, `userToken` or `adminToken` are set automatically based on the returned role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "",                      "type": "string" },
    { "key": "userToken",   "value": "",                      "type": "string" },
    { "key": "adminToken",  "value": "",                      "type": "string" }
  ],
