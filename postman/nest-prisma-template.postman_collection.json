    {
      "name": "Auth",
      "description": "Authentication & authorization endpoints",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"01700000000\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"statusCode\": 201,\n  \"message\": \"Registration successful. Please verify your email\",\n  \"meta\": null,\n  \"data\": {\n    \"userId\": \"uuid\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"01700000000\",\n    \"role\": \"USER\",\n    \"status\": \"INACTIVE\",\n    \"isVerified\": false,\n    \"profile\": null,\n    \"createdAt\": \"2026-09-04T12:00:00.000Z\",\n    \"updatedAt\": \"2026-09-04T12:00:00.000Z\"\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Verify OTP (Account Activation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Email verified successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"message\": \"Email verified successfully\",\n    \"isVerified\": true\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"type\": \"VERIFICATION\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"OTP sent successfully\",\n  \"meta\": null,\n  \"data\": {\n    \"message\": \"OTP sent successfully\"\n  },\n  \"timestamp\": \"2026-09-04T12:00:00.000Z\"\n}"
            }
          ]
        },
