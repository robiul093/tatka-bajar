// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  USER
  RIDER
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPEND
}

enum ProductUnit {
  KG
  GRAM
  PIECE
  LITER
  PACKET
  DOZEN
  BUNDLE
  BOX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BannerLinkType {
  CATEGORY
  PRODUCT
  OFFER
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  userId                String    @id @default(uuid())
  name                  String
  email                 String    @unique
  phone                 String    @unique
  password              String
  role                  Role      @default(USER)
  status                Status    @default(INACTIVE)
  profile               String?
  isVerified            Boolean   @default(false)
  verifiedOtp           String?
  verifiedOtpExpireAt   DateTime?
  resetPasswordOtp      String?
  resetPasswordExpireAt DateTime?
  refreshToken          String?
  isNotification        Boolean   @default(true)
  isAgree               Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  cart      Cart?
  reviews   Review[]
  rider     Rider?

  @@map("users")
}

// ─────────────────────────────────────────────
// RIDER
// ─────────────────────────────────────────────

model Rider {
  riderId         String   @id @default(uuid())
  userId          String   @unique
  isActive        Boolean  @default(true)
  totalDeliveries Int      @default(0)
  currentLat      Float?
  currentLng      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orders Order[]

  @@map("riders")
}

// ─────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────

model Address {
  addressId     String   @id @default(uuid())
  userId        String
  title         String   @default("Home")
  recipientName String
  phone         String
  streetAddress String
  area          String?
  city          String   @default("Dhaka")
  postalCode    String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  categoryId  String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  emoji       String?
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  productId     String      @id @default(uuid())
  categoryId    String
  name          String
  slug          String      @unique
  description   String?
  images        String[]    @default([])
  unit          ProductUnit @default(KG)
  unitValue     Float       @default(1.0)
  buyPrice      Float       @default(0)
  price         Float       // sell price
  discountPrice Float?
  isDiscount    Boolean     @default(false)
  stock         Int         @default(0)
  location      String?
  isOrganic     Boolean     @default(false)
  isSeasonal    Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  totalSold     Int         @default(0)
  totalRevenue  Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category   Category    @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([isFeatured, isActive])
  @@index([isActive, stock])
  @@map("products")
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model Cart {
  cartId    String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartItemId String   @id @default(uuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────

model Order {
  orderId       String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  riderId       String?
  addressId     String?
  subtotal      Float
  deliveryFee   Float         @default(0)
  discount      Float         @default(0)
  totalAmount   Float
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  deliveryNotes String?
  deliveryLat   Float?
  deliveryLng   Float?
  deliveredAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  rider   Rider?    @relation(fields: [riderId], references: [riderId], onDelete: SetNull)
  address Address?  @relation(fields: [addressId], references: [addressId], onDelete: SetNull)
  items   OrderItem[]

  @@index([userId])
  @@index([riderId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  orderItemId  String   @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String?
  productPrice Float
  buyPrice     Float    @default(0)
  quantity     Int
  totalPrice   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  reviewId  String   @id @default(uuid())
  userId    String
  productId String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// BANNER
// ─────────────────────────────────────────────

model Banner {
  bannerId        String         @id @default(uuid())
  title           String
  subtitle        String?
  tag             String?
  tagColor        String?        @default("#FF6B35")
  imageUrl        String
  linkType        BannerLinkType @default(CATEGORY)
  linkValue       String         // categoryId, productId, or offer keyword
  discountPercent Float?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}
